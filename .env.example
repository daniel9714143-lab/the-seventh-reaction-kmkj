SEVENTH_REACTION_DB_NAME=seventh_reaction
SEVENTH_REACTION_DB_USER=root
SEVENTH_REACTION_DB_PASS=
SEVENTH_REACTION_DB_HOST=127.0.0.1
SEVENTH_REACTION_DB_PORT=3306
SEVENTH_REACTION_DB_SOCKET=/Applications/XAMPP/xamppfiles/var/mysql/mysql.sock
SEVENTH_REACTION_DB_TLS=false
