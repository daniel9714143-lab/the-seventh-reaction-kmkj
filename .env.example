SEVENTH_REACTION_DB_NAME=seventh_reaction
SEVENTH_REACTION_DB_USER=root
SEVENTH_REACTION_DB_PASS=
SEVENTH_REACTION_DB_HOST=127.0.0.1
SEVENTH_REACTION_DB_PORT=3306
SEVENTH_REACTION_DB_SOCKET=/Applications/XAMPP/xamppfiles/var/mysql/mysql.sock
SEVENTH_REACTION_DB_TLS=false
SEVENTH_REACTION_DB_SSL_CA=

# Required only when provisioning the singleton administrator on a new database.
SEVENTH_REACTION_ADMIN_USER=admin_kmkj
SEVENTH_REACTION_ADMIN_PASSWORD=

# Optional direct OpenAI connection for XAMPP or another server.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional Vercel AI Gateway overrides. Vercel deployments otherwise use their
# automatic VERCEL_OIDC_TOKEN and the verified free-tier model below.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=openai/gpt-5.4-mini
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
